---
title: Strike48 Labs
description: Documentation for the Strike48 security platform
layout: false
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>Strike48 Labs</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/assets/css/vars.css">
    <link rel="stylesheet" href="/assets/css/custom.css">
    <link rel="stylesheet" href="/assets/css/landing.css">
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet">
    <script src="/pagefind/pagefind-ui.js"></script>
    <script>
      (function(){var t=localStorage.getItem("theme")||(matchMedia("(prefers-color-scheme:dark)").matches?"dark":"light");document.documentElement.setAttribute("data-theme",t)})();
    </script>
    <style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: "Inter", system-ui, sans-serif; color: var(--color-text); background: var(--color-bg); }
.neural-graph[data-mode="hero"] {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  pointer-events: none;
}
    </style>
  </head>
  <body>

    {{ set landing_header = true }}
    {{ include "partials/header.vto" }}

    {{ include "partials/cookie-banner.vto" }}

    <!-- Hero -->
    <section class="landing-hero" style="position: relative; overflow: visible;">
      <canvas class="neural-graph" data-mode="hero"></canvas>
      <div style="position: relative; z-index: 1;">
        <img src="/assets/img/strike48-labs-logo-light.svg" alt="Strike48" style="height: 300px; width: auto; margin: 100px auto 50px; display: block;">
      </div>
    </section>

    <div class="landing-body">
      <section class="landing-intro">
        <h1>Sharing Next-Gen Infrastructure Tooling</h1>
        <div class="side-by-side">
          <div class="one-side">
            <p>
            <em>Strike48 Labs</em> is a group of developers tasked with bringing wild ideas to life, building tools that
            push the boundaries of what's possible.
            </p>
            <p>
            We recognize that we are building on the shoulders of the giants who have preceded us, so we
            feel it's only right we should share what we do: the tools we build, the experiments we run, and the lessons we learn along the way.
            </p>
            <p>
            All this stuff is freely available under an MIT license.
            </p>
          </div>
          <div class="one-side highlight-links">
            <ul>
              <li>
                <p>
                <a href="#lab-notes">Read</a> our Lab Notes, where we share what we're working on now and the lessons we've learned.
                </p>
              </li>
              <li>
                <p>
                <a href="#tools">Explore</a> our growing suite of tools for red teamers, blue teamers, and security researchers—all built on the Strike48 platform.
                </p>
              </li>
              <li>
                <p>
                <a href="#frameworks">Develop</a> your own tools using our libraries and frameworks.
                </p>
              </li>
              <li>
                <p>
                <a href="#videos">Watch</a> videos where we demo features and ideas.
                </p>
              </li>
            </ul>
          </div>
        </div>
      </section>

      <!----------------------------- LAB NOTES ----------------------------------->

      {{ if features.blog }}
      {{ set posts = search.pages("type=blog", "date=desc", 6) }}
        <section class="landing-section">
          <div class="section-header">
            <h1 id="lab-notes">Read</h1>
            <h2>our notes on what we've built and discovered</h2>
          </div>
          <div class="lab-notes-header">
            <h1><a href="/blog/">Lab Notes</a></h2>
            <h2>see what we're working on, and what we learned along the way</h3>
          </div>
          <div class="blog-cards-grid">
          {{ for post of posts }}
            {{ set author = post.authors?.[0] ? author_info?.[post.authors[0]] : null }}
            <a href="{{ post.url }}" class="blog-card-landing">
              {{ if post.image }}
              <div class="blog-card-landing-image">
                <img src="{{ post.image }}" alt="{{ post.title }}" loading="lazy">
              </div>
              {{ /if }}
              <div class="blog-card-landing-body">
                {{ if post.tags }}
                <div class="blog-card-landing-tags">
                  {{ for tag of post.tags }}
                  <span class="tag-pill-sm">{{ tag }}</span>
                  {{ /for }}
                </div>
                {{ /if }}
                <h3>{{ post.title }}</h3>
                {{ if post.excerpt }}
                <p class="blog-card-landing-excerpt">{{ post.excerpt }}</p>
                {{ /if }}
                <div class="blog-card-landing-footer">
                  {{ if author?.picture }}
                  <img src="{{ author.picture }}" alt="{{ author.title || author.name }}">
                  {{ /if }}
                  <span>{{ author?.title || author?.name }}</span>
                  {{ if post.date }}
                  <span class="blog-card-landing-sep">&middot;</span>
                  <time datetime="{{ post.date.toISOString().split('T')[0] }}">{{ post.date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) }}</time>
                  {{ /if }}
                </div>
              </div>
            </a>
          {{ /for }}
          </div>
        </section>
      {{ /if }}

      <!---------------------------------  TOOLS ---------------------------------->

      <section class="landing-section">
        <div class="section-header">
          <h1 id="tools">Use</h1>
          <h2>the tools we build</h2>
        </div>
        <div class="products-grid">
          {{ for tool of tools }}
          <a href="{{ tool.url }}" class="product-card{{ if tool.image }} has-image{{ /if }}">
            <span class="product-card-sheen" aria-hidden="true"></span>
            {{ if tool.image }}
            <div class="product-card-media">
              <img src="{{ tool.image.src }}" alt="{{ tool.image.alt }}" loading="lazy">
            </div>
            {{ /if }}
            <div class="product-card-body">
              <h3>
                <span class="product-icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">{{ tool.icon }}</svg></span>
                {{ tool.name }}
              </h3>
              {{ if tool.lead }}
              <p class="lead">{{ tool.lead }}</p>
              {{ /if }}
              {{ for para of tool.description }}
              <p>{{ para }}</p>
              {{ /for }}
              <span class="product-card-arrow" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>
            </div>
          </a>
          {{ /for }}
        </div>
      </section>

      <!----------------------------- DEVELOPERS ---------------------------------->

      <section class="landing-section">
        <div class="section-header">
          <h1 id="frameworks">Develop</h1>
          <h2>using our libraries and frameworks</h2>
        </div>
        <div class="products-grid">
          {{ for dev of developers }}
          <a href="{{ dev.url }}" class="product-card{{ if dev.image }} has-image{{ /if }}">
            <span class="product-card-sheen" aria-hidden="true"></span>
            {{ if dev.image }}
            <div class="product-card-media">
              <img src="{{ dev.image.src }}" alt="{{ dev.image.alt }}" loading="lazy">
            </div>
            {{ /if }}
            <div class="product-card-body">
              <h3>
                <span class="product-icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">{{ dev.icon }}</svg></span>
                {{ dev.name }}
              </h3>
              {{ if dev.lead }}
              <p class="lead">{{ dev.lead }}</p>
              {{ /if }}
              {{ for para of dev.description }}
              <p>{{ para }}</p>
              {{ /for }}
              <span class="product-card-arrow" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>
            </div>
          </a>
          {{ /for }}
        </div>

      </section>


      <!----------------------------- VIDEOS ----------------------------------->

      {{ if features.video }}
      <section class="landing-section">
        <div class="section-header">
          <h1 id="videos">Watch</h1>
          <h2>as we show off a little...</h2>
        </div>
        <div class="products-grid">
          {{ for vid of videos }}
          <button class="product-card has-image video-card" data-youtube-id="{{ vid.youtube_id }}" aria-label="Play {{ vid.title }}">
            <span class="product-card-sheen" aria-hidden="true"></span>
            <div class="product-card-media video-card-thumb">
              <img src="https://img.youtube.com/vi/{{ vid.youtube_id }}/hqdefault.jpg" alt="{{ vid.title }}" loading="lazy">
              <span class="video-play-btn" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M8 5v14l11-7z"/></svg>
              </span>
            </div>
            <div class="product-card-body">
              <h3>
                <span class="product-icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect width="15" height="14" x="1" y="5" rx="2" ry="2"/></svg></span>
                {{ vid.product }}
              </h3>
              <p class="lead">{{ vid.title }}</p>
              <p class="video-highlight">{{ vid.highlight }}</p>
              <p>{{ vid.description }}</p>
            </div>
          </button>
          {{ /for }}
        </div>
      </section>
    </div>

    <!-- Video modal -->
    <div class="video-modal" id="video-modal" hidden>
      <div class="video-modal-backdrop"></div>
      <div class="video-modal-content">
        <button class="video-modal-close" aria-label="Close video">&times;</button>
        <div class="video-modal-player">
          <iframe id="video-modal-iframe" src="" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
      </div>
    </div>

    {{ /if }}

    <!-- Features -->
    <section class="features-section">
      <h2>Built for Increasing Productivity</h2>
      <div class="features-grid">
        <div class="feature-item">
          <div class="feature-icon"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22v-5"/><path d="M9 8V2"/><path d="M15 8V2"/><path d="M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8Z"/></svg></div>
          <h3>Connector Architecture</h3>
          <p>Modular connector system — each tool runs as an isolated process with its own UI, communicating over IPC.</p>
        </div>
        <div class="feature-item">
          <div class="feature-icon"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div>
          <h3>Secure by Default</h3>
          <p>Unix domain sockets for process isolation. OIDC authentication with automatic token injection. No ports exposed.</p>
        </div>
        <div class="feature-item">
          <div class="feature-icon"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></svg></div>
          <h3>Native Performance</h3>
          <p>Built with Rust and Dioxus for sub-2-second startup. WebView rendering with minimal memory overhead.</p>
        </div>
        <div class="feature-item">
          <div class="feature-icon"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M10 4v4"/><path d="M2 8h20"/><path d="M6 4v4"/></svg></div>
          <h3>Single Window</h3>
          <p>All your Strike48 connectors in one native window. Switch between tools without alt-tabbing.</p>
        </div>
        <div class="feature-item">
          <div class="feature-icon"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg></div>
          <h3>AI-Powered</h3>
          <p>Autonomous agents, RAG-enabled knowledge bases, and multi-step workflows — automate reconnaissance, analysis, and reporting with AI.</p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-section">
      <h2>Ready to get started?</h2>
      <p>Set up StrikeHub and start managing your connector apps in one place.</p>
      <div class="cta-group">
        <a href="/strikehub/getting-started/" class="cta-primary">Quick Start Guide</a>
        <a href="/overview/" class="cta-secondary">Browse Documentation</a>
      </div>
    </section>

    <script src="/assets/js/neural-graph.js"></script>
    <script src="/assets/js/theme-switcher.js"></script>
    <script src="/assets/js/cookie-consent.js"></script>
    <script src="/assets/js/header-search.js"></script>
    <script>
    (function() {
      var header = document.querySelector('.header--landing');
      var hero = document.querySelector('.landing-hero');
      if (!header || !hero) return;

      function update() {
        var heroBottom = hero.getBoundingClientRect().bottom;
        var headerHeight = header.offsetHeight;
        var opacity;

        if (heroBottom >= headerHeight) {
          opacity = 0;
        } else if (heroBottom <= 0) {
          opacity = 1;
        } else {
          opacity = 1 - (heroBottom / headerHeight);
        }

        header.style.setProperty('--header-bg-opacity', opacity);

        if (opacity > 0.5) {
          header.classList.add('header--solid');
        } else {
          header.classList.remove('header--solid');
        }
      }

      window.addEventListener('scroll', update, { passive: true });
      update();
    })();
    </script>
    <script>
    (function() {
      var modal = document.getElementById('video-modal');
      var iframe = document.getElementById('video-modal-iframe');
      var backdrop = modal.querySelector('.video-modal-backdrop');
      var closeBtn = modal.querySelector('.video-modal-close');

      function open(youtubeId) {
        iframe.src = 'https://www.youtube.com/embed/' + youtubeId + '?autoplay=1&rel=0';
        modal.hidden = false;
        document.body.style.overflow = 'hidden';
      }

      function close() {
        modal.hidden = true;
        iframe.src = '';
        document.body.style.overflow = '';
      }

      document.querySelectorAll('.video-card').forEach(function(card) {
        card.addEventListener('click', function() {
          var id = card.dataset.youtubeId;
          if (id && id !== 'REPLACE_ME') open(id);
        });
      });

      closeBtn.addEventListener('click', close);
      backdrop.addEventListener('click', close);
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && !modal.hidden) close();
      });
    })();
    </script>
  </body>
</html>
